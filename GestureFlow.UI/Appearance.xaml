<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="clr-namespace:GestureFlow.UI">
    <SolidColorBrush x:Key="Graphite" Color="{x:Static ui:BrandColors.Graphite}"/>
    <SolidColorBrush x:Key="Paper" Color="{x:Static ui:BrandColors.Paper}"/>
    <SolidColorBrush x:Key="Mist" Color="{x:Static ui:BrandColors.Mist}"/>
    <SolidColorBrush x:Key="CoolBlue" Color="{x:Static ui:BrandColors.CoolBlue}"/>
    <sys:Double x:Key="TitleSize">32</sys:Double>
    <sys:Double x:Key="SectionSize">17</sys:Double>
    <Thickness x:Key="SectionPadding">0,14,0,18</Thickness>
    <Thickness x:Key="ButtonPadding">12,6</Thickness>
    <Duration x:Key="HoverMotion">0:0:0.12</Duration>
    <Duration x:Key="PressMotion">0:0:0.09</Duration>
    <Duration x:Key="PageMotion">0:0:0.17</Duration>
    <Duration x:Key="DockMotion">0:0:0.20</Duration>
    <Duration x:Key="WheelMotion">0:0:0.11</Duration>
    <Duration x:Key="SelectionMotion">0:0:0.065</Duration>
    <Duration x:Key="DialogMotion">0:0:0.16</Duration>
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
    <ui:LightTextConverter x:Key="LightText"/>
    <Style x:Key="MatteWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Paper}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Foreground, RelativeSource={RelativeSource Self}, Converter={StaticResource LightText}}" Value="True">
                <Setter Property="Background" Value="{StaticResource Graphite}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="ui:Motion.ButtonFeedback" Value="True"/>
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}"/>
    </Style>
    <Style x:Key="QuietRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}"/>
                        </Border>
                        <Border x:Name="Mark" Background="{StaticResource CoolBlue}" Width="3" Height="16" CornerRadius="1.5"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Setter TargetName="Row" Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="BrandMark">
        <Canvas Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Fill="{StaticResource Mist}" Data="M10,1 A10,10 0 0 0 1,10 L6,10 A5,5 0 0 1 10,6 Z M1,12 A10,10 0 0 0 10,21 L10,16 A5,5 0 0 1 6,12 Z M12,21 A10,10 0 0 0 21,12 L16,12 A5,5 0 0 1 12,16 Z"/>
            <Path Fill="{StaticResource CoolBlue}" Data="M12,1 A10,10 0 0 1 21,10 L16,10 A5,5 0 0 0 12,6 Z"/>
        </Canvas>
    </DataTemplate>
    <Style x:Key="Section" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource SectionPadding}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
    </Style>
</ResourceDictionary>
