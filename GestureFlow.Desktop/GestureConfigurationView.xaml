<UserControl x:Class="GestureFlow.Desktop.GestureConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GestureFlow.Desktop"
             xmlns:core="clr-namespace:GestureFlow.Core;assembly=GestureFlow.Core"
             xmlns:ui="clr-namespace:GestureFlow.UI;assembly=GestureFlow.UI"
             PreviewKeyDown="CaptureKey" PreviewKeyUp="ReleaseKey" IsVisibleChanged="ViewVisibilityChanged">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/GestureFlow.UI;component/Appearance.xaml"/></ResourceDictionary.MergedDictionaries>
        <local:WheelDarkThemeConverter x:Key="DarkWheelTheme" />

        <Style x:Key="ConfigurationButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,8,8" SizeChanged="LayoutChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="WheelPanel" Padding="0,8,0,12" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="方向预览" FontSize="17" FontWeight="SemiBold" />
                    <Border x:Name="PreviewSurface" CornerRadius="8" Margin="0,10,0,0"
                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ui:RadialWheel x:Name="PreviewWheel" Height="292" MouseLeftButtonDown="WheelDirectionClick"
                                        AutomationProperties.Name="手势轮盘预览"
                                        IsDark="{Binding Background, ElementName=PreviewSurface, Converter={StaticResource DarkWheelTheme}}" />
                    </Border>
                </StackPanel>
            </Border>
            <Border x:Name="EditorCard" Grid.Column="2" Padding="0,8,0,12" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <ComboBox x:Name="ModePicker" DockPanel.Dock="Right" MinWidth="100" SelectedValuePath="Tag"
                                  SelectedValue="{Binding Mode, Mode=TwoWay}" IsEnabled="{Binding NamesValid}"
                                  AutomationProperties.Name="轮盘方向数">
                            <ComboBoxItem Content="4 方向" Tag="{x:Static core:GestureMode.Four}" />
                            <ComboBoxItem Content="8 方向" Tag="{x:Static core:GestureMode.Eight}" />
                        </ComboBox>
                        <TextBlock Text="方向绑定" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Text="点击快捷键可录制同时按下的组合。点「编辑…」可选择同时按或依次按。"
                               TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ItemsControl x:Name="BindingRows" ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/></Trigger>
                                    </Style.Triggers></Style></Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <Button Content="{Binding DirectionLabel}" Click="DirectionClick" Padding="4,2" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding Availability}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Availability}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBox x:Name="ActionNameBox" Grid.Column="1" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0" AutomationProperties.Name="{Binding NameFieldLabel}" />
                                    <Button Grid.Column="2" Click="RecordClick" LostKeyboardFocus="RecordLostFocus"
                                            HorizontalContentAlignment="Center" Padding="6,4"
                                            ToolTip="{Binding ShortcutLabel}" AutomationProperties.Name="{Binding ShortcutFieldLabel}">
                                        <TextBlock Text="{Binding ShortcutLabel}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                    <Button Grid.Column="3" Content="编辑…" Click="TypeShortcutClick" Margin="4,0,0,0" Padding="6,4" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="SaveGestureButton" Content="保存配置" Click="SaveClick" IsEnabled="{Binding CanSave}"
                                Style="{StaticResource ConfigurationButton}" />
                        <Button Content="还原此方案的默认绑定" Click="RestoreDefaultsClick" Style="{StaticResource ConfigurationButton}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding State}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
