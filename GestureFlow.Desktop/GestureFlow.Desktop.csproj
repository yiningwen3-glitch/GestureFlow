<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>../GestureFlow.UI/Assets/GestureFlow.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <InternalsVisibleTo Include="GestureFlow.Tests" />
    <ProjectReference Include="../GestureFlow.UI/GestureFlow.UI.csproj" />
    <AssemblyMetadata Include="GestureFlowDeveloper" Value="$(GestureFlowDeveloper)" />
    <AssemblyMetadata Include="GestureFlowDeveloperContact" Value="$(GestureFlowDeveloperContact)" />
    <EmbeddedResource Include="../docs/USER_GUIDE.md;../docs/SAFETY.md;../docs/FAQ.md;../docs/COMPATIBILITY.md;../docs/PRIVACY.md;../docs/THIRD_PARTY.md;../CHANGELOG.md"
                      LogicalName="GestureFlow.Offline.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../LICENSE" LogicalName="GestureFlow.Offline.LICENSE"
                      Condition="Exists('$(MSBuildProjectDirectory)/../LICENSE')" />
  </ItemGroup>
</Project>
